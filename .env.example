# Copy to .env (local) or add in Vercel > Project > Settings > Environment Variables.
# Every variable is optional. No API keys or secrets are needed.

# Comma-separated hosts the request builder may call (subdomains included).
# Empty = any public host (SSRF protections still apply).
# Recommended for a public deployment:
PULSECHECK_ALLOWED_HOSTS=jsonplaceholder.typicode.com,httpbin.org,api.github.com,pokeapi.co,catfact.ninja

PULSECHECK_ALLOWED_PORTS=80,443,8080,8443
PULSECHECK_MAX_RESPONSE_BYTES=1000000
PULSECHECK_MAX_REQUEST_BODY_BYTES=100000
PULSECHECK_MAX_REDIRECTS=3
PULSECHECK_RATE_LIMIT_PER_MINUTE=30
